    <string name="fake_t_probe_intro">Antes de começar, algumas perguntas para descobrir até onde vai o seu entendimento.</string>
    <string name="fake_t_mod_question">Quanto é 17 mod 5?</string>
    <string name="fake_t_mod_thinking">17 é 3 × 5 + 2, então o resto é 2.</string>
    <string name="fake_t_public_question">Quando uma mensagem é cifrada com a chave pública de alguém, quem consegue decifrá-la?</string>
    <string name="fake_t_public_a">Qualquer pessoa que tenha a chave pública</string>
    <string name="fake_t_public_b">Só quem tem a chave privada correspondente</string>
    <string name="fake_t_public_c">Ninguém, até os dois lados combinarem uma senha</string>
    <string name="fake_t_public_thinking">Acho que só a chave privada desfaz, mas não sei explicar por que a pública não consegue.</string>
    <string name="fake_t_recall_question">Com suas palavras: o que torna uma função “de mão única”?</string>
    <string name="fake_t_recall_answer">É fácil de calcular, mas difícil voltar do resultado para a entrada.</string>
    <string name="fake_t_node_modular">Aritmética modular</string>
    <string name="fake_t_node_oneway">Funções de mão única</string>
    <string name="fake_t_node_dlog">Logaritmo discreto</string>
    <string name="fake_t_node_trapdoor">Funções alçapão</string>
    <string name="fake_t_node_dh">Troca de chaves Diffie–Hellman</string>
    <string name="fake_t_node_rsa">Criptografia RSA</string>
    <string name="fake_t_node_goal">Compartilhar um segredo com estranhos</string>
    <string name="fake_t_plan_intro">Você já conhece aritmética modular e sabe o que é uma função de mão única. Este é o caminho daí até o seu objetivo.</string>
    <string name="fake_t_plan_reply">Isso corresponde ao que você quer entender? Diga com suas palavras se faltar algo.</string>
    <string name="fake_t_prediction_question">Alice e Bob escolhem, cada um, seu próprio número secreto e só conversam por uma linha pública. Eles conseguem chegar ao mesmo número secreto?</string>
    <string name="fake_t_prediction_yes">Sim, sem nunca enviar os segredos</string>
    <string name="fake_t_prediction_no">Não, um deles precisa enviar um segredo</string>
    <string name="fake_t_prediction_thinking">Talvez eles misturem os números com algo público, como cores de tinta?</string>
    <string name="fake_t_reasoning">O aprendiz previu que sim e recorreu à analogia das tintas. Começar pela regra dos expoentes mod p, depois mostrar a troca como uma sequência e verificar se ele entende por que Eva fica presa.</string>
    <string name="fake_t_dh_lead">O **Diffie–Hellman** funciona porque os expoentes podem ser aplicados em qualquer ordem, mesmo mod *p*:</string>
    <string name="fake_t_dh_steps">- Alice escolhe um segredo *a* e envia *A = gᵃ mod p*.\n- Bob escolhe um segredo *b* e envia *B = gᵇ mod p*.\n- Cada um eleva o que recebe ao próprio segredo, e os dois obtêm *gᵃᵇ mod p*.</string>
    <string name="fake_t_dh_eve">Eva vê *g*, *p*, *A* e *B*, mas nunca *a* nem *b*.</string>
    <string name="fake_t_check_question">Eva vê A e B. Por que ela não consegue calcular o segredo compartilhado?</string>
    <string name="fake_t_check_a">A e B são cifrados antes de serem enviados</string>
    <string name="fake_t_check_b">Ela precisaria de a ou b: um logaritmo discreto</string>
    <string name="fake_t_check_c">O segredo compartilhado nunca é calculado</string>
    <string name="fake_t_check2_question">Qual número Alice e Bob acabam compartilhando?</string>
    <string name="fake_t_check2_a">g^(a+b) mod p</string>
    <string name="fake_t_check2_b">g^(ab) mod p</string>
    <string name="fake_t_check_thinking">Se os números fossem pequenos, Eva poderia testar todos os expoentes.</string>
    <string name="fake_t_photo_caption">A foto do seu quadro: a linha entre as caixas é o canal público.</string>
    <string name="fake_t_photo_channel">Canal público</string>
    <string name="fake_t_photo_secret">Segredo compartilhado</string>
    <string name="fake_t_visual_title">Aritmética mod 12 como um relógio</string>
    <string name="fake_t_research_title">Qual deve ser o tamanho de p hoje?</string>
    <string name="fake_t_research_activity">Lendo 3 de 7 fontes</string>
    <string name="fake_t_demo_title">Teste o Diffie–Hellman com números pequenos</string>
